# Postgres — this app runs on Neon via Vercel's Postgres integration in
# production (`vercel integration add neon`, then `vercel env pull` for
# these two locally). DATABASE_URL_UNPOOLED is the direct (non-PgBouncer)
# connection `prisma migrate` needs — pooled connections don't support
# the prepared-statement/DDL semantics migrations require.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Signs session cookies — generate with `openssl rand -hex 32`, keep secret.
SESSION_SECRET=""

# Instagram API with Instagram Login (Business Login). Create a Meta App at
# https://developers.facebook.com/apps, add the "Instagram" product, and
# copy its Instagram App ID / Secret here. Add INSTAGRAM_REDIRECT_URI as an
# allowed OAuth redirect URI in the app's Instagram Business Login settings.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/callback"

# Apify — powers task verification (lib/apify.ts, lib/verification.ts):
# scrapes public Instagram posts/comments directly, no OAuth needed from
# brands or creators. Get a token at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=""
